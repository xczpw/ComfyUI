FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && \
    apt-get -y upgrade && \
    apt-get -y install git && \
    apt-get -y autoremove && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives
RUN pip install comfy-api-proxy

EXPOSE 8189

CMD comfy-api-proxy --host 0.0.0.0 --allow-insecure-bind
